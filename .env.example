# ---------------------------------------------------------------------------
# AI 智能分析机配置（可选）
# 不配置时系统自动降级为「本地启发式分析引擎」，功能不中断，只是分析精度下降。
# 支持任意 OpenAI 兼容接口（含 MiniMax、DeepSeek、OpenAI、通义千问等）
# ---------------------------------------------------------------------------

# 接口地址（OpenAI 兼容格式，需以 /v1 结尾）
# MiniMax 国内站 / 国际站分别为 https://api.minimax.chat/v1 与 https://api.minimax.io/v1
AI_BASE_URL=https://api.minimax.chat/v1

# 接口密钥
AI_API_KEY=

# 模型名（MiniMax-M3.1-Flash 与 MiniMax-M3 均为多模态，可直接读图）
# 注意：M2.5 / M2.7 已公告于 2026-11-18 退役，请勿再使用
AI_MODEL=MiniMax-M3.1-Flash

# 请求超时（毫秒）
AI_TIMEOUT_MS=25000

# 服务端口
PORT=5181

# ---------------------------------------------------------------------------
# 前端演示数据开关（可选）
# 接口不可用时是否回落到本地演示数据。
# 开发环境默认允许；生产构建默认禁止（接口异常时如实报错，不用假数据顶替真实学情）。
# ---------------------------------------------------------------------------
VITE_ALLOW_MOCK=false

# ---------------------------------------------------------------------------
# 首个系统管理员账号（可选）
# 首次启动时若用户表为空，系统会自动用下面这组账号创建「系统管理员」，
# 并强制要求首次登录后修改密码。创建后本文件不再生效（以数据库中的账号为准）。
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# GitHub 在线更新配置（可选）
# 在网页「⚙️ 系统设置 → 系统更新」里填写仓库地址后，可从 GitHub Release
# 一键更新本系统。若这里也填了，则网页里的配置优先（网页存数据库）。
#
# 仓库地址，格式 owner/repo
GITHUB_REPO=
# GitHub 访问令牌（可选）
# 公开仓库不需要；私有仓库或遇到 API 限流（60 次/小时）时需要。
# 只读检查更新用 fine-grained token 即可；若要在网页上「发布新版本」
# （把本机源码打成 Release），令牌还需要 contents:write 权限。
# 该值只从环境变量读取，不会写进数据库、不会在接口响应或日志中出现。
GITHUB_TOKEN=
# GitHub API 地址（可选，默认官方地址；仅自建 GitHub Enterprise 或测试时需要改）
GITHUB_API_BASE=https://api.github.com
# 附件上传地址（可选，默认 https://uploads.github.com；与 API 地址不是同一个域名）
GITHUB_UPLOAD_BASE=
# 访问 GitHub 使用的代理（可选，如 http://127.0.0.1:7890）
# 只影响 GitHub 相关请求（检查更新、下载更新包、发布 Release），
# 不影响 AI 模型接口调用。网页「系统设置 → 系统更新」里填的代理优先于此处。
# 注意：项目自带代理实现，改完立即生效、无需重启；
# 但仅支持 HTTP 代理（不支持 SOCKS5），且证书校验依然生效。
GITHUB_PROXY=

# ---------------------------------------------------------------------------
# 说明：以上 AI 配置为「服务端默认配置」。
# 用户也可以直接在网页左侧「⚙️ 系统设置 → AI 模型」里配置供应商、密钥与模型，
# 网页配置保存在本机服务端数据库中，优先级高于本文件。
# ---------------------------------------------------------------------------
