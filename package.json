{
  "name": "cuoti-analytics",
  "private": true,
  "version": "1.0.0",
  "description": "学生错题统计分析系统 — 面向小学/初中学生的拍照录入 + AI 智能分析 + 多维统计分析",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "node server/seed.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
  }
}
